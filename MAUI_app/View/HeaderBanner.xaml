<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_app.View.HeaderBanner"
             x:Name="ThisBanner">
             
    <Border StrokeThickness="0" Margin="0" Padding="20,35,20,35">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.1" 
                              Color="{AppThemeBinding Light=#42A5F5, Dark=#1a1a1a}" />
                <GradientStop Offset="1.0" 
                              Color="{AppThemeBinding Light=#0D47A1, Dark=Black}" />
            </LinearGradientBrush>
        </Border.Background>
        
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="0,0,24,24" />
        </Border.StrokeShape>

        <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
            
            <Button Text="❮" 
                    Clicked="OnBackButtonClicked"
                    IsVisible="{Binding ShowBackButton, Source={x:Reference ThisBanner}}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="26"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    WidthRequest="40"
                    VerticalOptions="Center"
                    Padding="0"/>

            <Image Source="medical_logo.png" 
                   HeightRequest="50" 
                   WidthRequest="50" 
                   VerticalOptions="Center" />
            
            <Label x:Name="WelcomeLabel" 
                   Text="Welcome!" 
                   TextColor="White" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
                   
        </HorizontalStackLayout>
    </Border>
</ContentView>