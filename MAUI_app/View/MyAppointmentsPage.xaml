<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MAUI_app.View"
             xmlns:model="clr-namespace:MAUI_app.Model"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
             x:Class="MAUI_app.View.MyAppointmentsPage"
             x:Name="ThisPage" 
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=Black}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <view:HeaderBanner Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto, *" Padding="20" RowSpacing="15">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">
                <Label Grid.Column="0" 
                       Text="All Scheduled Appointments" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#2C3E50, Dark=White}" 
                       VerticalOptions="Center" />
                
                <Button Grid.Column="1" 
                        x:Name="AddAppointmentBtn"
                        Text="+" 
                        Clicked="OnAddAppointmentClicked"
                        BackgroundColor="{AppThemeBinding Light=#27AE60, Dark=#2ECC71}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="22"
                        CornerRadius="10"
                        HeightRequest="35"
                        WidthRequest="35"
                        Padding="0"
                        VerticalOptions="Center"
                        IsVisible="False" />
                
                <ImageButton Grid.Column="2" 
                             Source="arrows_rotate_solid.png" 
                             ToolTipProperties.Text="Refresh"
                             Clicked="OnRefreshClicked"
                             BackgroundColor="{AppThemeBinding Light=#0D47A1, Dark=#1976D2}"
                             CornerRadius="10"
                             HeightRequest="35"
                             WidthRequest="35"
                             Padding="8"
                             VerticalOptions="Center">
                    <ImageButton.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="White" />
                    </ImageButton.Behaviors>
                </ImageButton>
            </Grid>

            <CollectionView x:Name="AllAppointmentsList" Grid.Row="1">
                
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,50">
                        <Label Text="No appointments found in database." 
                               HorizontalTextAlignment="Center" 
                               TextColor="{AppThemeBinding Light=Gray, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <!-- Added x:DataType here to resolve symbol warnings -->
                    <DataTemplate x:DataType="model:Appointment">
                        <Border Margin="5" 
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}" 
                                StrokeThickness="0" 
                                Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
                            </Border.Shadow>

                            <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="15">
                                
                                <Border Grid.Column="0" 
                                        BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#0D47A1}" 
                                        StrokeThickness="0" 
                                        Padding="10" 
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                                        <Label Text="{Binding AppointmentDate, StringFormat='{0:MMM}'}" 
                                               FontSize="12" FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light=#0D47A1, Dark=#BBDEFB}" 
                                               HorizontalOptions="Center" TextTransform="Uppercase"/>
                                        <Label Text="{Binding AppointmentDate, StringFormat='{0:dd}'}" 
                                               FontSize="22" FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light=#1C1C1E, Dark=White}" 
                                               HorizontalOptions="Center"/>
                                        <Label Text="{Binding AppointmentDate, StringFormat='{0:HH:mm}'}" 
                                               FontSize="12" 
                                               TextColor="{AppThemeBinding Light=#7F8C8D, Dark={StaticResource White}}" 
                                               HorizontalOptions="Center" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                                    <Label Text="{Binding DisplayName}" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#2C3E50, Dark=White}" />
                                    
                                    <HorizontalStackLayout Spacing="6">
                                        <BoxView Color="{AppThemeBinding Light=#BDC3C7, Dark={StaticResource Gray600}}" 
                                                 WidthRequest="4" HeightRequest="4" CornerRadius="2" VerticalOptions="Center"/>
                                        <Label Text="{Binding MedicalNotes, TargetNullValue='Standard Checkup'}" 
                                               FontSize="14" 
                                               TextColor="{AppThemeBinding Light=#7F8C8D, Dark={StaticResource Gray400}}" 
                                               VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="8" HorizontalOptions="End">
                                    <Border BackgroundColor="{AppThemeBinding Light=#E8F8F5, Dark=#154331}" 
                                            StrokeThickness="0" 
                                            Padding="15,8" 
                                            HorizontalOptions="End">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Status}" 
                                               FontSize="12" 
                                               FontAttributes="Bold" 
                                               TextColor="{AppThemeBinding Light=#27AE60, Dark=#2ECC71}" 
                                               TextTransform="Uppercase" 
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center" 
                                               HorizontalTextAlignment="Center" 
                                               VerticalTextAlignment="Center" />
                                    </Border>
                                    
                                    <ImageButton Source="pen_solid.png" 
                                                 ToolTipProperties.Text="Reschedule"
                                                 Clicked="OnRescheduleAppointmentClicked"
                                                 CommandParameter="{Binding .}"
                                                 IsVisible="{Binding CanReschedule, Source={x:Reference ThisPage}}"
                                                 BackgroundColor="{AppThemeBinding Light=#E8F8F5, Dark=#154331}"
                                                 HeightRequest="35"
                                                 WidthRequest="35"
                                                 Padding="8"
                                                 CornerRadius="18"
                                                 VerticalOptions="Center">
                                        <ImageButton.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=#27AE60, Dark=#2ECC71}" />
                                        </ImageButton.Behaviors>
                                    </ImageButton>

                                    <ImageButton Source="trash_solid.png" 
                                                 ToolTipProperties.Text="Cancel Appointment"
                                                 Clicked="OnCancelAppointmentClicked"
                                                 CommandParameter="{Binding .}"
                                                 BackgroundColor="{AppThemeBinding Light=#FDEDEC, Dark=#441111}"
                                                 HeightRequest="35"
                                                 WidthRequest="35"
                                                 Padding="8"
                                                 CornerRadius="18"
                                                 VerticalOptions="Center">
                                        <ImageButton.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=#E74C3C, Dark=#FF6B6B}" />
                                        </ImageButton.Behaviors>
                                    </ImageButton>
                                </HorizontalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>