<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MAUI_app.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:view="clr-namespace:MAUI_app.View"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    FlyoutBackgroundColor="{AppThemeBinding Light=#0D47A1, Dark=#1f1f1f}"
    FlyoutWidth="250"
    Shell.ForegroundColor="White"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Shell.Resources>
        <Style Class="FlyoutItemLayoutStyle" TargetType="Layout" ApplyToDerivedTypes="True">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </Shell.Resources>

    <Shell.FlyoutHeader>
        <Grid>
            <Border StrokeThickness="0" Margin="0" Padding="20,50,20,30" BackgroundColor="Transparent">
                
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    
                    <Border StrokeShape="Ellipse" 
                            HeightRequest="90" WidthRequest="90" 
                            HorizontalOptions="Center"
                            BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light=#90CAF9, Dark=#333333}"
                            StrokeThickness="2"
                            Padding="4">
                        
                        <Grid HeightRequest="80" WidthRequest="80">
                            <Ellipse Fill="White" HeightRequest="80" WidthRequest="80" />
                            <Image Source="user_icon.png" 
                                   Aspect="AspectFill"
                                   HeightRequest="70" WidthRequest="70"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Image.Clip>
                                    <EllipseGeometry Center="35,35" RadiusX="35" RadiusY="35" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        
                        <Label x:Name="UserNameLabel" 
                               Text="Loading..." 
                               TextColor="White" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                        
                        <Border BackgroundColor="{AppThemeBinding Light=#EBF5FB, Dark=#1A3A5A}"
                                StrokeThickness="0"
                                Padding="12,4"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label x:Name="UserRoleLabel"
                                   Text="ROLE"
                                   TextColor="{AppThemeBinding Light=#2980B9, Dark=#85C1E9}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextTransform="Uppercase" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid>
                
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter TargetName="ItemBorder" Property="Border.BackgroundColor" Value="White" />
                                    <Setter TargetName="ItemText" Property="Label.TextColor" Value="#0D47A1" />
                                    <Setter TargetName="MenuIconTint" Property="toolkit:IconTintColorBehavior.TintColor" Value="#0D47A1" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </VisualStateManager.VisualStateGroups>

                <Border x:Name="ItemBorder" 
                        BackgroundColor="Transparent" 
                        Padding="15,12,5,12" 
                        Margin="15,5,15,5" 
                        StrokeThickness="0" 
                        HorizontalOptions="Start"> 
                    
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15" />
                    </Border.StrokeShape>
                    
                    <HorizontalStackLayout Spacing="15">
                        <Image Source="{Binding FlyoutIcon}" HeightRequest="22" WidthRequest="22" VerticalOptions="Center">
                            <Image.Behaviors>
                                <toolkit:IconTintColorBehavior x:Name="MenuIconTint" TintColor="#BBDEFB" />
                            </Image.Behaviors>
                        </Image>
                        
                        <Label x:Name="ItemText" 
                               Text="{Binding Title}" 
                               TextColor="#BBDEFB" 
                               FontSize="15" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center" 
                               WidthRequest="140" 
                               LineBreakMode="TailTruncation" />
                    </HorizontalStackLayout>
                </Border>
                
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.FlyoutFooter>
        <Grid Padding="15,10,15,30" RowDefinitions="Auto, Auto" RowSpacing="10">
            
            <Border BackgroundColor="Transparent" Padding="15,12" StrokeThickness="0" Grid.Row="0">
                <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                    <Label Text="Dark Mode" 
                           TextColor="White" 
                           FontSize="15" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center"
                           WidthRequest="110"/>

                    <Switch x:Name="ThemeSwitch" 
                            Toggled="OnThemeSwitchToggled" 
                            VerticalOptions="Center"
                            OnColor="{AppThemeBinding Light=#0D47A1, Dark=#0D47A1}"
                            ThumbColor="White"/>
                </HorizontalStackLayout>
            </Border>

            <Border BackgroundColor="Transparent" Padding="15,12" StrokeThickness="0" Grid.Row="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSignOutTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="15">
                    
                    <Image Source="logout_icon.png" 
                           HeightRequest="22" 
                           WidthRequest="22" 
                           VerticalOptions="Center">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="White" />
                        </Image.Behaviors>
                    </Image>
                    
                    <Label Text="Logout" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>
    </Shell.FlyoutFooter>

    <ShellContent Title="Login"
                  ContentTemplate="{DataTemplate view:LoginPage}"
                  Route="LoginPage"
                  FlyoutItemIsVisible="False" />

    <FlyoutItem x:Name="DashboardItem" Title="Dashboard" Icon="home_icon.png" Shell.NavBarIsVisible="False">
        <ShellContent Route="dashboard" ContentTemplate="{DataTemplate view:DashboardPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Appointments" Icon="book_medical_solid.png">
        <ShellContent Route="appointments" ContentTemplate="{DataTemplate view:MyAppointmentsPage}" />
    </FlyoutItem>
    
    <FlyoutItem x:Name="AppointmentsHistoryItem" Title="History" Icon="calendar_icon.png" Shell.NavBarIsVisible="False">
        <ShellContent Route="AppointmentsHistoryPage" ContentTemplate="{DataTemplate view:AppointmentsHistoryPage}" />
    </FlyoutItem>
    
    <FlyoutItem x:Name="ProfileItem" Title="My Profile" Icon="user_icon.png" Shell.NavBarIsVisible="False">
        <ShellContent Route="profile" ContentTemplate="{DataTemplate view:SettingsPage}" />
    </FlyoutItem>

</Shell>