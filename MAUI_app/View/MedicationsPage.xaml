<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MAUI_app.View"
             xmlns:model="clr-namespace:MAUI_app.Model"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MAUI_app.View.MedicationsPage"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=Black}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <view:HeaderBanner Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto, *" Padding="20" RowSpacing="15">

            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Label Grid.Column="0" 
                       Text="Prescribed Medications" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="{AppThemeBinding Light=#2C3E50, Dark=White}" 
                       VerticalOptions="Center" />

                <Button Grid.Column="1" 
                        x:Name="AddMedicationButton"
                        Text="+" 
                        Clicked="OnAddMedicationClicked"
                        BackgroundColor="{AppThemeBinding Light=#27AE60, Dark=#2ECC71}"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="22"
                        CornerRadius="10"
                        HeightRequest="35"
                        WidthRequest="35"
                        Padding="0"
                        VerticalOptions="Center"
                        IsVisible="False" />
            </Grid>

            <CollectionView x:Name="MedicationsCollectionView" Grid.Row="1">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,50">
                        <Label Text="No medications found." 
                               TextColor="{AppThemeBinding Light=Gray, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="model:Medication">
                        <Border Margin="5" 
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}" 
                                StrokeThickness="0" 
                                Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.05" />
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="8">
                                
                                <Grid ColumnDefinitions="*, Auto">
                                    
                                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                        <Image Source="user_icon.png" HeightRequest="20" WidthRequest="20" VerticalOptions="Center">
                                            <Image.Behaviors>
                                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=#2C3E50, Dark=White}" />
                                            </Image.Behaviors>
                                        </Image>
                                        <Label Text="{Binding DisplayName}" 
                                               FontSize="20" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#2C3E50, Dark=White}" 
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Start" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type view:MedicationsPage}}, Path=IsDoctor}">
                                        
                                        <ImageButton Source="pen_solid.png" 
                                                     ToolTipProperties.Text="Edit Prescription"
                                                     Clicked="OnEditMedicationClicked"
                                                     CommandParameter="{Binding .}"
                                                     BackgroundColor="{AppThemeBinding Light=#E8F8F5, Dark=#154331}"
                                                     HeightRequest="35" WidthRequest="35" Padding="8" CornerRadius="18">
                                            <ImageButton.Behaviors>
                                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=#27AE60, Dark=#2ECC71}" />
                                            </ImageButton.Behaviors>
                                        </ImageButton>

                                        <ImageButton Source="trash_solid.png" 
                                                     ToolTipProperties.Text="Delete Prescription"
                                                     Clicked="OnDeleteMedicationClicked"
                                                     CommandParameter="{Binding .}"
                                                     BackgroundColor="{AppThemeBinding Light=#FDEDEC, Dark=#4A1C1C}"
                                                     HeightRequest="35" WidthRequest="35" Padding="8" CornerRadius="18">
                                            <ImageButton.Behaviors>
                                                <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=#E74C3C, Dark=#E57373}" />
                                            </ImageButton.Behaviors>
                                        </ImageButton>
                                        
                                    </HorizontalStackLayout>
                                    
                                </Grid>

                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Image Source="pill_icon.png" HeightRequest="16" WidthRequest="16" VerticalOptions="Center">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="{AppThemeBinding Light=#0D47A1, Dark=#64B5F6}" />
                                        </Image.Behaviors>
                                    </Image>
                                    <Label Text="{Binding MedicationName}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#0D47A1, Dark=#64B5F6}" 
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                
                                <Label Text="{Binding Instructions}" 
                                       FontSize="14" 
                                       TextColor="{AppThemeBinding Light=#7F8C8D, Dark={StaticResource Gray400}}" 
                                       Margin="0,4,0,4"/>

                                <HorizontalStackLayout Spacing="20" Margin="0,5,0,0">
                                    <Label Text="{Binding StartDate, StringFormat='Start: {0:MMM dd, yyyy}'}" 
                                           FontSize="12" TextColor="{AppThemeBinding Light=#7F8C8D, Dark=#BBDEFB}" />
                                    <Label Text="{Binding EndDate, StringFormat='End: {0:MMM dd, yyyy}'}" 
                                           FontSize="12" TextColor="{AppThemeBinding Light=#E74C3C, Dark=#FF6B6B}" />
                                </HorizontalStackLayout>
                                
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>